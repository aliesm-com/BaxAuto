# BaxAuto — copy to `.env` before `./start.sh`.
# Django loads these inside the API container; compose also substitutes Postgres creds.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,baxauto-api,baxauto-dashboard
TIME_ZONE=Asia/Tehran

# Compose always points the API at the BaxAuto Postgres service.
# Override only if you run an external catalog database.
# DATABASE_URL=postgresql://baxauto:baxauto@baxauto-postgres:5432/baxauto

POSTGRES_DB=baxauto
POSTGRES_USER=baxauto
POSTGRES_PASSWORD=baxauto

# Browser origins for the dashboard / landing / Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

# Fernet key for encrypting saved DB connection passwords.
# Generate once and keep stable: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_CREDENTIALS_FERNET_KEY=
