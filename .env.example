# BaxAuto — copy to `.env` before `./start.sh`.
# Django loads these inside the API container; compose also substitutes Postgres creds.

SECRET_KEY=change-me-in-production
DEBUG=True
# `*` so the dashboard works when opened via a public IP (e.g. http://5.63.13.234:18280).
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Tehran
# Optional: also adds this origin to CORS / CSRF (scheme + host + published port).
# BAXAUTO_PUBLIC_URL=http://5.63.13.234:18280
CORS_ALLOW_ALL_ORIGINS=True

# Compose always points the API at the BaxAuto Postgres service.
# Override only if you run an external catalog database.
# DATABASE_URL=postgresql://baxauto:baxauto@baxauto-postgres:5432/baxauto

POSTGRES_DB=baxauto
POSTGRES_USER=baxauto
POSTGRES_PASSWORD=baxauto

# Host ports published by Docker (container ports stay 8000 / 80 / 5432).
BAXAUTO_API_PORT=18200
BAXAUTO_DASHBOARD_PORT=18280
BAXAUTO_LANDING_PORT=18417
BAXAUTO_POSTGRES_PORT=15432

# Browser origins for the dashboard / landing / Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:18280,http://127.0.0.1:18280,http://localhost:18417,http://127.0.0.1:18417,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:18280,http://127.0.0.1:18280,http://localhost:18417,http://127.0.0.1:18417,http://localhost:5173,http://127.0.0.1:5173

# Fernet key for encrypting saved DB connection passwords.
# Generate once and keep stable: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_CREDENTIALS_FERNET_KEY=
