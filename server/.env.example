# Copy to `.env` and adjust. Loaded automatically when present (see baxconf/settings.py).

# Required in production — generate a strong random key, never commit real secrets.
# SECRET_KEY=

# true / false (django-environ)
DEBUG=True

# Comma-separated hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (requires DATABASE_URL to be set; otherwise SQLite under BASE_DIR is used)
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Frontend origins for CORS (comma-separated full URLs with scheme)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required when using HTTPS behind a proxy or cross-origin POST from browser (comma-separated)
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Fernet key for encrypting saved DB connection passwords (db_connections).
# Generate once and keep stable across deploys: losing/changing it makes old passwords unreadable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_CREDENTIALS_FERNET_KEY=
